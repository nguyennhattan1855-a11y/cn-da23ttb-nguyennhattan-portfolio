# Cấu hình riêng của từng máy (không đưa lên GitHub)
config/config.local.php

# Nhật ký lỗi
logs/*
!logs/.htaccess

# File người dùng tải lên (dữ liệu thật, không đưa lên GitHub)
uploads/images/*
!uploads/images/.gitkeep
storage/documents/*
!storage/documents/.gitkeep

# Hệ điều hành / trình soạn thảo
Thumbs.db
.DS_Store
